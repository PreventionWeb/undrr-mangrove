{
  "$description": "DELTA Resilience brand primitives — the single source Mangrove builds from. W3C DTCG design-token format (https://tr.designtokens.org/format/). Every consuming file is generated by `node scripts/build-tokens.cjs`; nothing here is duplicated by hand anywhere else in the repo. Add a value once, declare where it should surface in `$extensions`, rebuild.",
  "delta": {
    "$description": "DELTA Resilience (sub-brand of UNDRR).",
    "color": {
      "$type": "color",
      "primary": {
        "$value": "#132e48",
        "$description": "DELTA navy. Interactive colour: links, buttons, tabs, focus, tags.",
        "$extensions": {
          "org.undrr.mangrove": {
            "outputs": [
              {
                "target": "mangrove-sass",
                "name": "$_delta-color-primary--raw",
                "format": "srgb-channels"
              },
              {
                "target": "aria-tokens",
                "name": "--mg-color-interactive",
                "format": "srgb-channels"
              }
            ]
          }
        }
      },
      "primary-800": {
        "$value": "#0c1e30",
        "$description": "Pressed/hover shade of DELTA navy.",
        "$extensions": {
          "org.undrr.mangrove": {
            "outputs": [
              {
                "target": "mangrove-sass",
                "name": "$_delta-color-primary-800--raw",
                "format": "srgb-channels"
              },
              {
                "target": "aria-tokens",
                "name": "--mg-color-button--hover",
                "format": "srgb-channels"
              }
            ]
          }
        }
      },
      "ink": {
        "$value": "#181823",
        "$description": "Body text and overlay/shadow base.",
        "$extensions": {
          "org.undrr.mangrove": {
            "outputs": [
              {
                "target": "mangrove-sass",
                "name": "$_delta-color-dark--raw",
                "format": "srgb-channels"
              },
              {
                "target": "aria-tokens",
                "name": "--mg-color-text",
                "format": "srgb-channels"
              },
              {
                "target": "aria-tokens",
                "name": "$_delta-color-ink--raw",
                "format": "srgb-channels"
              }
            ]
          }
        }
      },
      "card-surface": {
        "$value": "#fafafa",
        "$description": "Card / subtle surface fill.",
        "$extensions": {
          "org.undrr.mangrove": {
            "outputs": [
              {
                "target": "mangrove-sass",
                "name": "$_delta-color-card-bg--raw",
                "format": "srgb-channels"
              },
              {
                "target": "aria-tokens",
                "name": "--mg-card-background",
                "format": "srgb-rgb-function"
              }
            ]
          }
        }
      }
    },
    "font": {
      "family-base": {
        "$type": "fontFamily",
        "$value": ["Dubai", "sans-serif"],
        "$description": "DELTA body typeface. The @font-face src URLs are an asset declaration, not a token, and stay hand-written in aria/_tokens-delta.scss.",
        "$extensions": {
          "org.undrr.mangrove": {
            "outputs": [
              {
                "target": "aria-tokens",
                "name": "$_delta-font-family-name",
                "format": "font-family-name"
              },
              {
                "target": "aria-tokens",
                "name": "$_delta-font-family-stack",
                "format": "font-family-stack"
              }
            ]
          }
        }
      }
    }
  }
}
